# Breakfastclub Orders Portal - Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ═════════════════════════════════════════════════════════════════════════
# SUPABASE (Database & Auth)
# ═════════════════════════════════════════════════════════════════════════
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ═════════════════════════════════════════════════════════════════════════
# RECAPTCHA v3 (Bot Protection)
# Get keys from: https://www.google.com/recaptcha/admin
# ═════════════════════════════════════════════════════════════════════════
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ═════════════════════════════════════════════════════════════════════════
# WHATSAPP (Meta Cloud API)
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/
# 1. Create a Meta Business Account
# 2. Create a WhatsApp Business Account
# 3. Create a Phone Number ID and get Access Token
# 4. Create an OTP template and get it approved
# ═════════════════════════════════════════════════════════════════════════
WA_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WA_ACCESS_TOKEN=your-whatsapp-access-token

# ═════════════════════════════════════════════════════════════════════════
# RAZORPAY (Payment Gateway)
# Get keys from: https://dashboard.razorpay.com/settings/api-keys
# Note: RAZORPAY_KEY_ID is safe to expose; RAZORPAY_KEY_SECRET must be kept private
# ═════════════════════════════════════════════════════════════════════════
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ═════════════════════════════════════════════════════════════════════════
# SESSION & SECURITY
# ═════════════════════════════════════════════════════════════════════════
SESSION_SECRET=your-super-secret-key-for-session-tokens-min-32-chars-recommended
NODE_ENV=production

# ═════════════════════════════════════════════════════════════════════════
# API CONFIGURATION (for local development)
# ═════════════════════════════════════════════════════════════════════════
API_BASE=http://localhost:3000  # Change to your Vercel domain in production

# ═════════════════════════════════════════════════════════════════════════
# OPTIONAL: Admin Notifications
# ═════════════════════════════════════════════════════════════════════════
ADMIN_EMAIL=admin@breakfastclub.co.in
ADMIN_NOTIFICATION_URL=https://your-webhook-url
